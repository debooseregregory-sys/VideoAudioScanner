@dataclass
class VideoItem:
    path: str
    name: str
    size: int
    extension: str
    modified: float = 0.0
    metadata: dict | None = None
    favorite: bool = False
    watched: bool = False


class WorkerSignals(QObject):
    finished = Signal(str, object)


class MetadataTask(QRunnable):
    def __init__(self, path: str, signals: WorkerSignals):
        super().__init__()
        self.path = path
        self.signals = signals
        self.setAutoDelete(True)

    def run(self):
        self.signals.finished.emit(self.path, read_metadata(self.path))


class ThumbnailTask(QRunnable):
    def __init__(self, path: str, cache_path: str, signals: WorkerSignals):
        super().__init__()
        self.path = path
        self.cache_path = cache_path
        self.signals = signals
        self.setAutoDelete(True)

    def run(self):
        # Worker-thread doet alleen bestand/FFmpeg werk.
        # QPixmap wordt uitsluitend in de GUI-thread gemaakt.
        data = None

        if os.path.isfile(self.cache_path):
            try:
                data = Path(self.cache_path).read_bytes()
            except OSError:
                data = None

        if data is None:
            data = make_thumbnail_bytes(self.path)

            if data:
                try:
                    Path(self.cache_path).write_bytes(data)
                except OSError:
                    pass

        self.signals.finished.emit(self.path, data)


